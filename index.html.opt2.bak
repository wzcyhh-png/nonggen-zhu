            { src: "images/confucian-temple/jianshui_wenmiao_aerial.webp", caption: "【实景照片】建水文庙航拍——从空中俯瞰建水文庙的宏伟布局，泮池、棂星门、大成殿依次排列", title: "建水文庙航拍" },
