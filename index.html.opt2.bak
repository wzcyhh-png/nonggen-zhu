                '2-2-P-04': 'gallery-2-2-P-04',
                '2-2-D-01': 'gallery-2-2-D-01',
                // 第二展区 - 滇西北高海拔山地景观
                '2-3-S-01': 'gallery-2-3-S-01',
                // 第二展区 - 山地农具（2-3-P-01到2-3-P-08）
                '2-3-P-01': 'gallery-2-3-P-01',
                '2-3-P-02': 'gallery-2-3-P-02',
                '2-3-P-03': 'gallery-2-3-P-03',
