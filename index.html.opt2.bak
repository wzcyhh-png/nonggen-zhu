            // ========== 第三展区 ==========
            {
                id: "section-3",
                type: "section",
                number: "第三展区",
                title: "土脉共生——多民族农耕民俗与非遗文脉",
                percentage: "12%",
                intro: "",
                units: [
                    {
                        id: "unit-3-1",
                        title: "第一单元：族群共耕——民族团结的农耕文明记忆",
                        spatial: "",
                        intro: "儒家精神融入说明：云南\"牛亲家\"\"换工互助\"等跨族群协作模式，不是行政命令的结果，而是生存需求和文化共识共同作用的结果，正是儒家\"己欲立而立人，己欲达而达人\"\"民为贵\"等\"仁爱\"\"民本\"思想在民间最生动的实践。",
                        exhibits: [
                            { id: "3-1-P-01", name: "\"牛亲家\"跨族群协作模式图解", type: "图片/动画", ref: "参考哈尼梯田文化博物馆资料制作", note: "集体劳作传统", evidence: "依据汇报稿", desc: "儒家\"仁者爱人\"思想的民间实践——《论语》\"己欲立而立人，己欲达而达人\"，自己想立足也帮助别人立足。云南不同民族农户共用耕牛、相互换工，不分彼此地协作，正是\"仁爱\"精神在民间最生动的实践。" },
                            { id: "3-1-P-02", name: "\"换工互助\"传统图解", type: "图片/文字", ref: "同上", note: "农忙时节协作", evidence: "同上", desc: "" },
                            { id: "3-1-P-03", name: "多民族联合修建梯田的乡规民约碑文拓本", type: "图片", ref: "参考各地发现的碑文", note: "制度化协作传统", evidence: "哈尼梯田区域七种世居民族集体生态智慧", desc: "" }
                        ]
                    },
                    {
                        id: "unit-3-2",
                        title: "第二单元：农事节俗——农耕生活化的非物质文化遗产",
                        spatial: "",
                        intro: "",
                        exhibits: [
                            { id: "3-2-V-01", name: "哈尼族\"开秧门\"仪式视频", type: "视频/图片", ref: "素材来自CCTV或云南地方电视台报道", note: "春耕祭祀", evidence: "人民网云南频道（2021）", desc: "\"开秧门\"与中原\"籍田礼\"同为春耕祈福仪式，精神内核相通，表达形式各具特色" },
                            { id: "3-2-V-02", name: "哈尼族\"卡农欧\"丰收节视频", type: "视频/图片", ref: "素材来自CCTV或云南地方电视台报道", note: "秋收传统", evidence: "哈尼族传统仪式", desc: "" },
                            { id: "3-2-A-01", name: "哈尼族《四季生产调》音频片段", type: "音频/图片", ref: "云南省非遗中心藏", note: "国家级非遗·民间文学", evidence: "2006年列入第一批国家级非物质文化遗产名录", desc: "国家级非物质文化遗产·民间文学。哈尼族《四季生产调》完整传续传统农耕技艺、传授生产知识，是活态传承的农耕技术百科全书，与中原《诗经·七月》等农事诗遥相呼应。" },
                            { id: "3-2-V-03", name: "哈尼棕扇舞", type: "视频/图片", ref: "素材来自云南省非遗中心", note: "国家级非遗·传统舞蹈", evidence: "国家级非物质文化遗产代表性项目", desc: "国家级非物质文化遗产·传统舞蹈。哈尼棕扇舞是哈尼农耕文化的舞蹈表达，源于梯田稻作生产中的祭祀与娱乐活动。" },
                            { id: "3-2-V-04", name: "彝族\"秧佬鼓舞\"", type: "视频/图片", ref: "素材来自云南省非遗中心", note: "省级非遗·传统舞蹈", evidence: "\"双河彝族秧佬鼓舞之乡\"2005年列入云南省首批非物质文化遗产保护名录", desc: "省级非物质文化遗产·传统舞蹈。彝族秧佬鼓舞是农耕祭祀舞蹈的文化价值体现。" },
                            { id: "3-2-P-01", name: "各民族农事节令农谚展示墙", type: "文字/图片", ref: "---", note: "农耕知识口耳相传", evidence: "哈尼族、彝族、白族等农谚", desc: "云南各民族农谚与中原二十四节气一样，都是农耕智慧的结晶" }
                        ]
                    },
                    {
                        id: "unit-3-3",
                        title: "第三单元：农艺非遗——传统农耕技艺的活态传承",
                        spatial: "",
                        intro: "",
                        exhibits: [
                            { id: "3-3-V-01", name: "传统铁质农具打造技艺视频", type: "视频/图片", ref: "素材来自云南传统工艺纪录片", note: "农具制作技艺", evidence: "依据汇报稿及《云南物质文化·农耕卷》", desc: "铁质农具打造技术与中原一脉相承，但造型适应云南地貌" },
                            { id: "3-3-P-01", name: "傣族稻田养鱼技艺图解", type: "图片/动画", ref: "参考科普动画《稻＋模式是什么》", note: "传统生态种养", evidence: "云南省科普资源信息中心", desc: "稻田养鱼是云南对中原\"稻鱼共生\"技术的本土化发展" },
                            { id: "3-3-P-02", name: "陆良桑蚕丝织造技艺——种桑养蚕全流程图解", type: "图片/动画", ref: "参考陆良桑蚕丝织造非遗资料制作", note: "从种桑到丝织", evidence: "陆良种桑最早可追溯到元代", desc: "省级非物质文化遗产·传统技艺。蚕桑技术源于中原，在云南形成独特的地方品种与工艺。2017年列入云南省省级非物质文化遗产保护名录。" },
