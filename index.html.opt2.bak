        const jianshuiWenmiaoSteleImages = [
            { src: "images/confucian-temple/jianshui_wenmiao_gongdebei.webp", caption: "【实景照片】建水文庙碑刻——文庙内现存多通明清碑刻，记载历次修缮学宫、兴学劝农之事。棂星门旁东西碑廊保存有元代至大元年（1308年）武宗皇帝追封孔子为「大成至圣文宣王」的圣旨碑，及历代有关重修学宫、学庙田产、丁祭大典等三十余通碑刻（来源：Wikimedia Commons，CC0 / 公共领域）", title: "建水文庙碑刻" },
            { src: "images/confucian-temple/east_stele_hallway_01.webp", caption: "【实景照片】建水文庙东碑廊——位于棂星门东侧，廊庑式碑刻陈列区。保存有元朝至大元年圣旨碑及历代重修学宫、学庙田产、丁祭大典等三十余通碑刻。是「以碑存史、以碑载道」的文化载体，记录了中原儒学在云南边徼的传播历程（来源：Wikimedia Commons，CC0 / 公共领域）", title: "东碑廊碑刻陈列" },
            { src: "images/confucian-temple/west_stele_hallway_01.webp", caption: "【实景照片】建水文庙西碑廊——保存有明代至清代临安府儒学科甲题名和历代德政碑，警示、训导、圣谕、程子四篇及部分科甲题名碑。记载了明清临安府（今建水）进士、举人名录，是滇南科举盛况的直接见证（来源：Wikimedia Commons，CC0 / 公共领域）", title: "西碑廊碑刻陈列" },
            { src: "images/confucian-temple/chongxiu_ruxue_ji_text.webp", caption: "【原文摘抄】《重修建水州儒学记》——记建水州儒学之设，始于元泰定二年（1325年），佥宪杨祚题请建学。万历四十三年知州赵士龙详设州学，巡按御史吴应琦疏请设建水州儒学于庙左启圣公祠前。崇祯十三年重建。曾鼎撰碑记云：「为师者以斯道为教，为弟子者以斯道为学，则不负朝廷建学之意，而圣人之道岂有不明也哉？」（原文摘自清·祝宏《建水州志》卷十五「艺文记」，来源：识典古籍）", title: "《重修建水州儒学记》原文摘抄" },
        ];

