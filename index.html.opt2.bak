                            <div class="exhibit-name">${exhibit.name}</div>
                            ${exhibit.desc ? `<div class="exhibit-detail"><span class="exhibit-detail-label">说明：</span>${exhibit.desc}</div>` : ''}
                            ${exhibit.evidence ? `<div class="exhibit-detail"><span class="exhibit-detail-label">佐证：</span>${exhibit.evidence}</div>` : ''}
                            ${exhibit.ref ? `<div class="exhibit-detail"><span class="exhibit-detail-label">参考：</span>${exhibit.ref}</div>` : ''}
                            ${exhibit.note ? `<div class="exhibit-note">${exhibit.note}</div>` : ''}
                        </div>
                    </div>
                `;
            }

            // 特殊处理：1-2-P-17 中原人口迁徙与农耕技术传入云南综合时间轴（大事件图示）
            if (exhibit.id === '1-2-P-17') {
                return `
                    <div class="exhibit-card timeline-card">
                        <div class="timeline-banner">
                            <span class="image-tag">${exhibit.type}</span>
                            <div class="timeline-banner-title">中原人口迁徙与农耕技术传入云南</div>
                            <div class="timeline-banner-sub">战国（约前279年）— 清代（1911年）·七次大规模迁徙</div>
                        </div>
                        <div class="exhibit-content timeline-content">
                            <div class="exhibit-header">
                                <span class="exhibit-id">${exhibit.id}</span>
                            </div>
                            <div class="exhibit-name">${exhibit.name}</div>
                            <div class="timeline-container">
                                <!-- 时间轴主线 -->
                                <div class="timeline-axis"></div>

                                <!-- 事件1：庄蹻入滇 -->
                                <div class="timeline-item" data-event="1">
                                    <div class="timeline-dot" style="background:#8B4513;"></div>
                                    <div class="timeline-era">战国</div>
                                    <div class="timeline-year">约公元前279年</div>
                                    <div class="timeline-card-body">
                                        <div class="timeline-title">庄蹻入滇</div>
                                        <div class="timeline-desc">楚将庄蹻率军循江上，略巴、黔中以西，至滇池。"变服从俗"，建立滇国。中原农耕技术与青铜文化首次大规模传入云南</div>
                                        <div class="timeline-tech">传入技术：青铜农具、中原农作物</div>
                                        <div class="timeline-source">《史记·西南夷列传》</div>
                                        ${renderTimelineMiniGallery('zhuangqiao-timeline-gallery')}
                                    </div>
                                </div>

                                <!-- 事件2：秦开五尺道 -->
                                <div class="timeline-item" data-event="2">
                                    <div class="timeline-dot" style="background:#6B3A2A;"></div>
                                    <div class="timeline-era">秦汉</div>
                                    <div class="timeline-year">约公元前250年—公元220年</div>
                                    <div class="timeline-card-body">
                                        <div class="timeline-title">秦开五尺道 · 汉置郡县</div>
                                        <div class="timeline-desc">秦修五尺道连通巴蜀与滇，汉武帝开西南夷设益州郡。铁制农具、牛耕技术大规模传入，中原农耕制度初步建立</div>
                                        <div class="timeline-tech">传入技术：铁制农具、牛耕、郡县制度</div>
                                        <div class="timeline-source">《史记·西南夷列传》《汉书》</div>
                                        ${renderTimelineMiniGallery('wuchidao-timeline-gallery')}
                                    </div>
                                </div>

                                <!-- 事件3：诸葛亮南征 -->
                                <div class="timeline-item" data-event="3">
                                    <div class="timeline-dot" style="background:#556B2F;"></div>
                                    <div class="timeline-era">三国</div>
                                    <div class="timeline-year">225年</div>
                                    <div class="timeline-card-body">
                                        <div class="timeline-title">诸葛亮南征 · 屯田劝农</div>
                                        <div class="timeline-desc">诸葛亮平定南中后推行屯田劝农政策，汉族军户与本地民族融合耕作，中原农耕技术与南中本土农耕深度结合</div>
                                        <div class="timeline-tech">传入技术：屯田制度、灌溉技术</div>
                                        <div class="timeline-source">《三国志·蜀书·诸葛亮传》</div>
                                        ${renderTimelineMiniGallery('zhugeliang-timeline-gallery')}
                                    </div>
                                </div>

                                <!-- 事件4：南诏掳掠西川 -->
                                <div class="timeline-item" data-event="4">
                                    <div class="timeline-dot" style="background:#B8860B;"></div>
                                    <div class="timeline-era">唐代</div>
                                    <div class="timeline-year">829年</div>
                                    <div class="timeline-card-body">
                                        <div class="timeline-title">南诏掳掠西川工匠</div>
                                        <div class="timeline-desc">南诏攻陷成都，"虏子女、百工数万人"。蜀地工匠入滇后，"南诏工巧埒于蜀中"，蜀地先进农耕技术和手工业"被动输入"云南</div>
                                        <div class="timeline-tech">传入技术：纺织、冶金、先进手工业</div>
                                        <div class="timeline-source">《新唐书·南诏传》《蛮书》</div>
                                        ${renderTimelineMiniGallery('timeline-manshu-gallery')}
                                    </div>
                                </div>

                                <!-- 事件5：赛典赤治滇 -->
                                <div class="timeline-item" data-event="5">
                                    <div class="timeline-dot" style="background:#4682B4;"></div>
                                    <div class="timeline-era">元代</div>
                                    <div class="timeline-year">1274—1279年</div>
                                    <div class="timeline-card-body">
                                        <div class="timeline-title">赛典赤·赡思丁治滇</div>
                                        <div class="timeline-desc">首任云南行省平章政事，创建松华坝、金汁河、银汁河灌溉系统，"教民播种，为陂池以备水旱"。中原水利技术系统性引入云南</div>
                                        <div class="timeline-tech">传入技术：大型水利工程、行省屯田</div>
                                        <div class="timeline-source">《元史·赛典赤传》</div>
                                        ${renderTimelineMiniGallery('saidianchi-timeline-gallery')}
                                    </div>
                                </div>

                                <!-- 事件6：明代三屯并举 -->
                                <div class="timeline-item" data-event="6">
                                    <div class="timeline-dot" style="background:#CD853F;"></div>
                                    <div class="timeline-era">明代</div>
                                    <div class="timeline-year">1381—1644年</div>
                                    <div class="timeline-card-body">
                                        <div class="timeline-title">明代"三屯并举"·移民大潮</div>
                                        <div class="timeline-desc">沐英镇滇，推行军屯、民屯、商屯"三屯并举"。江南移民大规模入滇，"包包散"传说即为明初移民携带种子入滇的历史记忆。农耕制度与作物新品种全面推广</div>
                                        <div class="timeline-tech">传入技术：三屯制度、江南作物品种、精耕细作</div>
                                        <div class="timeline-source">《明史·沐英传》《明史·食货志》</div>
                                        ${renderTimelineMiniGallery('timeline-mingshi-gallery')}
                                    </div>
                                </div>

                                <!-- 事件7：清代矿冶移民 -->
                                <div class="timeline-item" data-event="7">
                                    <div class="timeline-dot" style="background:#708090;"></div>
                                    <div class="timeline-era">清代</div>
                                    <div class="timeline-year">1644—1911年</div>
                                    <div class="timeline-card-body">
                                        <div class="timeline-title">清代矿冶业·人口迁入</div>
                                        <div class="timeline-desc">"滇铜甲天下"，铜矿、银矿吸引内地数十万人口入滇。矿区周边大规模开垦农田，山地农耕边界进一步拓展，云南农业版图基本奠定</div>
                                        <div class="timeline-tech">传入技术：采矿冶炼、山地开垦</div>
                                        <div class="timeline-source">清代云南矿冶业史研究</div>
                                        ${renderTimelineMiniGallery('qingkuangye-timeline-gallery')}
                                    </div>
                                </div>

                                <!-- 时间轴末端 -->
                                <div class="timeline-end">
                                    <div class="timeline-end-dot"></div>
                                    <div class="timeline-end-text">同源异流 · 农耕文明扎根云南</div>
                                </div>
                            </div>
                            ${exhibit.ref ? `<div class="exhibit-detail"><span class="exhibit-detail-label">参考：</span>${exhibit.ref}</div>` : ''}
                            ${exhibit.note ? `<div class="exhibit-note">${exhibit.note}</div>` : ''}
                        </div>
                    </div>
                `;
            }

            // ==================== 第二、三、四展区展项图片画廊 ====================
            // 展项ID到画廊ID的映射表
            const galleryMap = {
                // 第一展区第二单元 - 农具与农耕技术
                '1-2-P-01': 'gallery-1-2-P-01',
                '1-2-P-02': 'gallery-1-2-P-02',
                // 第一展区第二单元 - 梯田开垦
                '1-2-P-03': 'gallery-1-2-P-03',
                // 第一展区第二单元 - 物产（甘薯、马铃薯、烟草）
                '1-2-P-05': 'gallery-1-2-P-05',
                '1-2-P-06': 'gallery-1-2-P-06',
                '1-2-P-07': 'gallery-1-2-P-07',
                // 第一展区第二单元 - 明代移民
                '1-2-P-15': 'gallery-1-2-P-15',
                // 第一展区第二单元 - 清代矿冶业
                '1-2-P-16': 'gallery-1-2-P-16',
                // 第一展区第二单元 - 建水文庙
                '1-2-P-18': 'gallery-1-2-P-18',
                '1-2-P-19': 'gallery-1-2-P-19',
                '1-2-Q-01': 'gallery-1-2-Q-01',
                // 第一展区第二单元 - 儒道思想入滇
                '1-2-D-06': 'gallery-1-2-D-06',
                // 第二展区 - 坝区景观（2-1-S-01、S-02）
                '2-1-S-01': 'gallery-2-1-S-01',
                '2-1-S-02': 'gallery-2-1-S-02',
                // 第二展区 - 坝区农具和农耕（2-1-P-01到2-1-P-08）
                '2-1-P-01': 'gallery-2-1-P-01',
                '2-1-P-02': 'gallery-2-1-P-02',
                '2-1-P-03': 'gallery-2-1-P-03',
                '2-1-P-04': 'gallery-2-1-P-04',
                '2-1-P-05': 'gallery-2-1-P-05',
                '2-1-P-06': 'gallery-2-1-P-06',
                '2-1-P-07': 'gallery-2-1-P-07',
                '2-1-P-08': 'gallery-2-1-P-08',
                // 第二展区 - 哈尼梯田（2-2-S-01、S-02、P-01到P-04、D-01）
                '2-2-S-01': 'gallery-2-2-S-01',
                '2-2-S-02': 'gallery-2-2-S-02',
                '2-2-P-01': 'gallery-2-2-P-01',
                '2-2-P-02': 'gallery-2-2-P-02',
