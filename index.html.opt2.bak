                '2-3-P-05': 'gallery-2-3-P-05',
                '2-3-P-06': 'gallery-2-3-P-06',
                '2-3-P-07': 'gallery-2-3-P-07',
                '2-3-P-08': 'gallery-2-3-P-08',
                // 第二展区 - 热区农具与经济作物（2-4-P-01到P-03）
                '2-4-P-01': 'gallery-2-4-P-01',
                '2-4-P-02': 'gallery-2-4-P-02',
