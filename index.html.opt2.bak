        // ==================== 渲染导航 ====================
        function renderNav() {
            const navContainer = document.getElementById('nav-container');
            let html = '';

            exhibitionData.forEach((section, sIndex) => {
                const isHall = section.type === 'hall';
                html += `<div class="nav-section" id="nav-${section.id}">`;
                html += `<div class="nav-section-title" onclick="toggleSection('${section.id}')">
                    <span>${section.number} · ${section.title.split('——')[0]}</span>
                    <span class="arrow">▼</span>
                </div>`;
                html += `<ul class="nav-units">`;

                section.units.forEach((unit, uIndex) => {
                    if (isHall) {
                        html += `<li class="nav-unit" onclick="scrollToSection('${section.id}')">${section.title}</li>`;
                    } else {
                        html += `<li class="nav-unit" onclick="scrollToSection('${unit.id}')">${unit.title.replace(/第[一二三四五六七八九十]+单元：/, '')}</li>`;
                    }
                });

                html += `</ul></div>`;
            });

            navContainer.innerHTML = html;
        }

        // ==================== 渲染内容 ====================
        function renderContent() {
            const container = document.getElementById('content-container');
            let html = '';

            exhibitionData.forEach((section) => {
                const isHall = section.type === 'hall';
                const sectionClass = isHall ? 'exhibition-section hall-section' : 'exhibition-section';

                html += `<section class="${sectionClass}" id="${section.id}">`;

                // 展区标题
                html += `<div class="section-header">`;
                html += `<div class="section-number">${section.number} · ${section.percentage}</div>`;
                html += `<div class="section-title">${section.title}</div>`;
                if (section.spatial) {
                    html += `<div class="section-desc">${section.spatial}</div>`;
                }
                if (section.intro) {
                    html += `<div class="section-desc" style="margin-top:15px;">${section.intro}</div>`;
                }
                html += `</div>`;

                // 各单元
                section.units.forEach((unit) => {
                    if (!isHall) {
                        html += `<div class="unit-section" id="${unit.id}">`;
                        html += `<div class="unit-header">`;
                        html += `<div class="unit-title">${unit.title}</div>`;
                        if (unit.spatial) {
                            html += `<span class="unit-spatial">${unit.spatial}</span>`;
                        }
                        html += `</div>`;

                        if (unit.intro) {
                            html += `<div class="unit-intro">${unit.intro}</div>`;
                        }
                    }

                    // 展项网格
                    if (unit.exhibits && unit.exhibits.length > 0) {
                        html += `<div class="exhibits-grid">`;
                        unit.exhibits.forEach((exhibit) => {
                            html += renderExhibitCard(exhibit);
                        });
                        html += `</div>`;
                    }

                    // 专题区块
                    if (unit.specialTopics && unit.specialTopics.length > 0) {
                        unit.specialTopics.forEach((topic) => {
                            html += `<div class="special-topic">`;
                            html += `<div class="special-topic-title">${topic.title}</div>`;
                            html += `<div class="exhibits-grid">`;
                            topic.exhibits.forEach((exhibit) => {
                                html += renderExhibitCard(exhibit);
                            });
                            html += `</div></div>`;
                        });
                    }

                    if (!isHall) {
                        html += `</div>`;
                    }
                });

                html += `</section>`;
            });

            container.innerHTML = html;
        }

        // ==================== 渲染单个展项卡片 ====================
        function renderExhibitCard(exhibit) {
            // 特殊处理：X-P-01 遗址分布互动地图
            if (exhibit.id === 'X-P-01') {
                return `
                    <div class="exhibit-card has-map">
                        <div class="exhibit-image map-clickable" onclick="openMapLightbox()">
                            <span class="image-tag">${exhibit.type}</span>
                            <span class="map-zoom-hint">🔍 点击放大查看</span>
                            ${renderSiteMapSVG()}
                        </div>
                        <div class="exhibit-content">
                            <div class="exhibit-header">
                                <span class="exhibit-id">${exhibit.id}</span>
                            </div>
                            <div class="exhibit-name">${exhibit.name}</div>
                            ${exhibit.desc ? `<div class="exhibit-detail"><span class="exhibit-detail-label">说明：</span>${exhibit.desc}</div>` : ''}
                            ${exhibit.evidence ? `<div class="exhibit-detail"><span class="exhibit-detail-label">佐证：</span>${exhibit.evidence}</div>` : ''}
                            ${exhibit.ref ? `<div class="exhibit-detail"><span class="exhibit-detail-label">参考：</span>${exhibit.ref}</div>` : ''}
                            ${exhibit.note ? `<div class="exhibit-note">${exhibit.note}</div>` : ''}
