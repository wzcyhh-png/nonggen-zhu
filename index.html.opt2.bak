                '4-2-P-05': 'gallery-4-2-P-05',
                '4-2-P-06': 'gallery-4-2-P-06',
                // 尾厅 - 建水文庙
                'W-D-02': 'gallery-W-D-02',
                // 第五展区 - 校史老照片（第一单元：百年弦歌）
                '5-1-P-01': 'gallery-5-1-P-01',
