        // ==================== 遗址弹窗（博物馆风格） ====================
        function showSitePopup(siteId, event) {
            // 移除已有弹窗
            const oldPopup = document.getElementById('site-popup');
            if (oldPopup) oldPopup.remove();

            const site = farmingSites.find(s => s.id === siteId);
            if (!site) return;

            const popup = document.createElement('div');
            popup.id = 'site-popup';
            popup.className = 'site-popup show';

            let cropsHtml = '';
            if (site.crops && site.crops.length > 0) {
                cropsHtml = `<div class="site-popup-crops">
                    <div class="site-popup-crops-label">出土作物遗存</div>
                    ${site.crops.map(c => `<span class="site-popup-crop-tag">${c}</span>`).join('')}
                </div>`;
            }

            popup.innerHTML = `
                <div class="site-popup-header">
                    <div class="site-popup-title">${site.name}</div>
                    <div class="site-popup-subtitle">${site.location}</div>
                    <button class="site-popup-close" onclick="closeSitePopup()">×</button>
                </div>
                <div class="site-popup-body">
                    <span class="site-popup-era">${site.era}</span>
                    ${cropsHtml}
                    <div class="site-popup-desc">${site.desc}</div>
                </div>
            `;

            document.body.appendChild(popup);

            // 定位弹窗
            const rect = event.target.getBoundingClientRect();
            let left = rect.right + 15;
            let top = rect.top;

            // 防止超出视窗
            const popupRect = popup.getBoundingClientRect();
            if (left + popupRect.width > window.innerWidth - 20) {
                left = rect.left - popupRect.width - 15;
            }
            if (top + popupRect.height > window.innerHeight - 20) {
                top = window.innerHeight - popupRect.height - 20;
            }
            if (top < 20) top = 20;

            popup.style.left = left + 'px';
            popup.style.top = top + 'px';

            // 点击外部关闭
            setTimeout(() => {
                document.addEventListener('click', closeSitePopupOutside);
            }, 10);
        }

        function closeSitePopup() {
            const popup = document.getElementById('site-popup');
            if (popup) popup.remove();
            document.removeEventListener('click', closeSitePopupOutside);
        }

        function closeSitePopupOutside(e) {
            const popup = document.getElementById('site-popup');
            if (popup && !popup.contains(e.target) 
                && !e.target.closest('.map-site-marker') 
                && !e.target.classList.contains('site-marker-label')) {
                closeSitePopup();
            }
        }

        // ==================== 地图放大弹窗 ====================
        function openMapLightbox() {
            let lightbox = document.getElementById('map-lightbox');
            if (!lightbox) {
                lightbox = document.createElement('div');
                lightbox.id = 'map-lightbox';
                lightbox.className = 'map-lightbox';
                lightbox.onclick = function(e) {
                    if (e.target.id === 'map-lightbox') closeMapLightbox();
                };
                document.body.appendChild(lightbox);
            }

            // 获取地图SVG内容（从渲染函数获取）
            const mapSvg = renderSiteMapSVG();

            lightbox.innerHTML = `
                <button class="lightbox-close" onclick="closeMapLightbox()">×</button>
                <button class="lightbox-download" onclick="event.stopPropagation(); downloadMapAsImage()">下载原图</button>
                <div class="map-lightbox-container">
                    <div class="map-lightbox-title">云南主要农耕遗址分布图</div>
                    <div class="map-lightbox-content" id="map-lightbox-content">
                        ${mapSvg}
                    </div>
                    <div class="map-lightbox-desc">点击地图上的遗址标记可查看详情 · 支持鼠标滚轮缩放</div>
                </div>
            `;

            lightbox.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeMapLightbox() {
            const lightbox = document.getElementById('map-lightbox');
            if (lightbox) {
                lightbox.classList.remove('show');
                setTimeout(() => {
                    if (lightbox.parentNode) {
                        lightbox.parentNode.removeChild(lightbox);
                    }
                }, 300);
            }
            document.body.style.overflow = '';
        }

        function downloadMapAsImage() {
            const svgEl = document.querySelector('#map-lightbox-content svg');
            if (!svgEl) {
                alert('地图加载中，请稍候再试');
                return;
            }

            // 克隆SVG并设置尺寸
            const svgClone = svgEl.cloneNode(true);
            const svgData = new XMLSerializer().serializeToString(svgClone);
            const svgBlob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
            const url = URL.createObjectURL(svgBlob);

            const img = new Image();
            img.onload = function() {
                // 创建canvas，输出高分辨率PNG
                const canvas = document.createElement('canvas');
                const scale = 2; // 2倍清晰度
                canvas.width = img.width * scale;
                canvas.height = img.height * scale;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#FEF3C7'; // 背景色
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                // 下载
                canvas.toBlob(function(blob) {
                    const link = document.createElement('a');
                    link.download = '云南主要农耕遗址分布图.png';
                    link.href = URL.createObjectURL(blob);
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(url);
                }, 'image/png');
            };
            img.src = url;
        }

        // ==================== 时间轴文献记录迷你画廊 ====================
        function renderTimelineMiniGallery(galleryId) {
            const images = getGalleryImages(galleryId);
            if (!images || images.length === 0) return '';
            return `
                <div class="timeline-refs">
                    <div class="timeline-refs-title">📜 文献原文记录（点击放大查看）</div>
                    <div class="timeline-mini-gallery">
                        ${images.map((img, idx) => `
                            <div class="timeline-mini-gallery-item" onclick="openLightbox('${galleryId}', ${idx})">
                                <span class="timeline-mini-gallery-item-badge">${idx + 1}</span>
                                <img src="${img.src}" alt="${img.title}" loading="lazy">
                                <div class="timeline-mini-gallery-item-caption">${img.title}</div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        // ==================== 图片画廊渲染 ====================
        function renderImageGallery(galleryId, images) {
            if (!images || images.length === 0) return '';

            const firstImg = images[0];
            let thumbsHtml = '';
            images.forEach((img, idx) => {
                const active = idx === 0 ? 'active' : '';
                thumbsHtml += `<div class="gallery-thumb ${active}" onclick="setGalleryImage('${galleryId}', ${idx})">
                    <img src="${img.src}" alt="${img.title}" loading="lazy">
                </div>`;
            });

            return `
                <div class="image-gallery" id="${galleryId}" data-current="0" data-total="${images.length}">
                    <div class="gallery-main" onclick="openLightbox('${galleryId}')">
                        <span class="gallery-counter">1 / ${images.length}</span>
                        <button class="gallery-download-btn" onclick="event.stopPropagation(); downloadGalleryImage('${galleryId}')" title="下载原图">
                            <span>⬇ 下载原图</span>
                        </button>
                        <img src="${firstImg.src}" alt="${firstImg.title}" class="gallery-main-img" loading="lazy">
                        <div class="gallery-main-caption">${firstImg.caption}</div>
                        <button class="gallery-nav prev" onclick="event.stopPropagation(); prevGalleryImage('${galleryId}')">‹</button>
                        <button class="gallery-nav next" onclick="event.stopPropagation(); nextGalleryImage('${galleryId}')">›</button>
                    </div>
                    <div class="gallery-thumbs">
                        ${thumbsHtml}
                    </div>
                </div>
            `;
        }

        function getGalleryImages(galleryId) {
            if (galleryId === 'nongke-gallery') return nongkeImages;
            if (galleryId === 'gantangqing-gallery') return gantangqingImages;
