            { src: "images/erhai_paddy/erhai_paddy_field_02.webp", caption: "【实景照片】喜洲秋收割稻——洱海西岸喜洲地区十月稻田秋收场景，农人在田间收割稻谷。大理坝区自然条件优越，稻麦两熟、精耕细作，是滇西农耕文化的核心地带（来源：Wikimedia Commons, CC BY-SA 4.0）", title: "洱海坝区秋收割稻" },
            { src: "images/erhai_paddy/erhai_paddy_field_03.webp", caption: "【实景照片】洱海与苍山——大理洱海与苍山自然风光，苍山十九峰为屏，洱海碧水为镜，展现大理坝区得天独厚的地理环境（来源：Wikimedia Commons, CC BY-SA 4.0）", title: "洱海与苍山" },
            { src: "images/erhai_paddy/erhai_paddy_field_04.webp", caption: "【实景照片】云南农民插秧——云南省水稻移栽场景，农人佩戴斗笠在水田中弯腰插秧，展现云南传统稻作移栽技术。云南各民族在长期实践中发展出适应不同海拔和气候条件的水稻种植方式（来源：Wikimedia Commons, CC BY-SA 2.0）", title: "云南农民插秧" },
            { src: "images/erhai_paddy/erhai_paddy_field_05.webp", caption: "【实景照片】大理稻作村落——2019年大理洱海周边稻作村落景观，展现传统水稻种植区域与村落的空间关系。大理坝区是云南稻作文明的重要区域之一（来源：Wikimedia Commons, CC BY-SA 4.0）", title: "大理稻作村落" },
        ];

