            { src: "images/confucian-temple/jianshui_wenmiao_building_10.webp", caption: "【实景照片】洙泗渊源牌坊——建水文庙内重要牌坊，纪念孔子在洙泗之间讲学，传播儒家文化", title: "洙泗渊源牌坊" },
            { src: "images/confucian-temple/jianshui_wenmiao_xuehai_01.webp", caption: "【实景照片】泮池（学海）——建水文庙半月形池塘，象征孔子学海无涯，是文庙的标志性景观", title: "泮池学海" },
