                            { id: "2-1-P-01", name: "滇池地区大四角框架长犁底曲辕犁", type: "模型/图片", ref: "参考尹绍亭《云南物质文化·农耕卷》附图", note: "与唐代\"江东犁\"完全相同", evidence: "《云南不同地区畜力犁比较分析》", desc: "曲辕犁源于中原，但传入云南后演化出多种适应不同地形的变体，是\"同源异流\"最直观的技术证据" },
                            { id: "2-1-P-02", name: "滇池地区大四角框架长曲辕犁", type: "模型/图片", ref: "同上", note: "二牛牵引", evidence: "同上", desc: "" },
                            { id: "2-1-P-03", name: "滇池地区三角框架曲辕犁", type: "模型/图片", ref: "同上", note: "小型框架犁", evidence: "同上", desc: "" },
                            { id: "2-1-P-04", name: "滇池地区小框架长犁辕二牛抬杠犁", type: "模型/图片", ref: "同上", note: "彝族特色，木犁壁", evidence: "同上", desc: "木犁壁是云南对中原铁犁壁的本土化改良" },
                            { id: "2-1-P-05", name: "坝区传统木耙", type: "模型/图片", ref: "参考云南传统农具博物馆藏品", note: "精耕细作工具", evidence: "《云南物质文化·农耕卷》", desc: "水田整地用" },
                            { id: "2-1-P-06", name: "坝区传统镰刀", type: "模型/图片", ref: "同上", note: "传统收割工具", evidence: "同上", desc: "" },
                            { id: "2-1-P-07", name: "稻麦轮作、稻豆复种模式图解动画", type: "图片/动画", ref: "参考《云南农业社会变迁史》制作", note: "提升耕地复种能力", evidence: "依据汇报稿", desc: "稻麦复种在剑川海门口遗址已有考古证据，比中原地区更早出现，是云南对农耕技术的独特贡献" },
                            { id: "2-1-P-08", name: "传统农家肥养地技艺图解", type: "图片/文字", ref: "参考传统农事技艺资料制作", note: "\"用地养地\"农耕智慧", evidence: "依据汇报稿", desc: "" }
                        ]
                    },
                    {
                        id: "unit-2-2",
                        title: "第二单元：梯田耕魂——滇南、滇东南区域的山地文明奇迹",
                        spatial: "以梯田为背景的沉浸式空间",
                        intro: "道家精神融入——四素同构没有任何\"人为强加\"的成分，完全是顺应自然地理条件而生成的生态闭环，是\"道法自然\"在农耕实践中的完美呈现。",
                        exhibits: [
                            { id: "2-2-S-01", name: "红河哈尼梯田全景（灌水期）", type: "模型/图片", ref: "参考元阳梯田实景照片建模", note: "核心景观", evidence: "坝达梯田总面积14000余亩，垂直落差1200米，3700多级", desc: "梯田是云南先民对中原农耕技术的创造性转化——在同一技术基因上，发展出适应山地的全新形态" },
                            { id: "2-2-S-02", name: "\"森林—村寨—梯田—水系\"四素同构生态模型", type: "模型/图片（可交互拆解）", ref: "参考哈尼梯田\"四素同构\"描述建模", note: "生态闭环", evidence: "\"森林是顶，村寨是腰，梯田是裙，水系是脉\"", desc: "四素同构是云南农耕\"异流\"的最典型代表。这一体系没有任何\"人为强加\"的成分，完全是顺应自然地理条件而生成的生态闭环——森林涵养水源（\"法地\"），村寨顺应山势而建（\"法天\"），梯田依山就势开垦（\"法道\"），水系循环利用（\"法自然\"）。这正是道家\"道法自然\"哲学在农耕实践中的完美呈现。" },
                            { id: "2-2-D-01", name: "\"哈尼梯田——全球唯一三遗产桂冠的农耕文明奇迹\"身份展板", type: "文字/图片", ref: "参考联合国教科文组织、联合国粮农组织、国际灌溉排水委员会认定资料", note: "三重遗产身份集中展示", evidence: "世界文化遗产（2013年）；全球重要农业文化遗产（2010年）；世界灌溉工程遗产（2022年）", desc: "哈尼梯田是全球首个同时拥有世界文化遗产、全球重要农业文化遗产、世界灌溉工程遗产\"三顶桂冠\"的农耕文化遗产。" },
                            { id: "2-2-P-01", name: "哈尼族蘑菇房", type: "模型/图片", ref: "参考阿者科村蘑菇房实景", note: "传统民居与梯田共生", evidence: "哈尼族传统民居", desc: "" },
                            { id: "2-2-P-02", name: "竹管分水器/刻木分水", type: "模型/图片", ref: "中国丝绸博物馆藏\"分水木刻\"", note: "科学灌溉制度", evidence: "长139cm，宽24cm，木质", desc: "\"刻木分水\"体现了云南先民在水利管理上的独创智慧" },
                            { id: "2-2-P-03", name: "梯田小型铁锄", type: "模型/图片", ref: "参考哈尼梯田文化博物馆展品", note: "适配狭小田块", evidence: "《云南物质文化·农耕卷》", desc: "" },
                            { id: "2-2-P-04", name: "梯田\"护林碑\"\"分水碑\"拓本系列", type: "图片（系列）", ref: "参考各地发现的碑文", note: "制度化传统", evidence: "依据汇报稿", desc: "碑文制度与中原\"水规\"传统相通，但因地制宜地演化出适应梯田环境的规则" }
                        ]
                    },
                    {
                        id: "unit-2-3",
                        title: "第三单元：山地耕息——滇东北、滇西北区域的高原适应智慧",
                        spatial: "高海拔山地氛围，色调偏冷峻",
                        intro: "",
                        exhibits: [
                            { id: "2-3-S-01", name: "滇西北高海拔山地景观", type: "模型/图片", ref: "参考滇西北实景照片建模", note: "高海拔农耕环境", evidence: "依据汇报稿", desc: "" },
                            { id: "2-3-P-01", name: "德钦犁（藏族，无框架结构）", type: "模型/图片", ref: "参考《云南不同地区畜力犁比较分析》附图", note: "印度犁体系", evidence: "《云南不同地区畜力犁比较分析》", desc: "德钦犁是印度犁体系与云南本土犁具的结合，体现云南作为农耕文化十字路口的独特地位" },
                            { id: "2-3-P-02", name: "维西犁（无框架结构）", type: "模型/图片", ref: "同上", note: "构造独特", evidence: "同上", desc: "" },
                            { id: "2-3-P-03", name: "中甸丽江犁（藏族、纳西族，四角框架）", type: "模型/图片", ref: "同上", note: "纳西象形文字中犁的图形与今日几乎无异", evidence: "同上；纳西象形文字谱", desc: "" },
                            { id: "2-3-P-04", name: "大理剑川犁（三角框架）", type: "模型/图片", ref: "同上", note: "北方传入犁型在滇西北的演变", evidence: "同上", desc: "" },
                            { id: "2-3-P-05", name: "怒江犁（傈僳族）", type: "模型/图片", ref: "同上", note: "峡谷坡地小型化", evidence: "同上", desc: "" },
                            { id: "2-3-P-06", name: "中甸三坝彝族犁", type: "模型/图片", ref: "同上", note: "彝族特色", evidence: "同上", desc: "" },
                            { id: "2-3-P-07", name: "宁蒗摩梭人犁", type: "模型/图片", ref: "同上", note: "\"江东犁\"型", evidence: "同上", desc: "" },
                            { id: "2-3-P-08", name: "山地杂粮作物系列", type: "模型/图片（系列）", ref: "参考云南地方志记载制作", note: "高海拔适生作物", evidence: "依据汇报稿", desc: "玉米、马铃薯、荞麦、燕麦——玉米、马铃薯等作物传入云南后，在高海拔山区发展出与中原完全不同的种植体系" }
                        ]
                    },
                    {
                        id: "unit-2-4",
                        title: "第四单元：热区耕韵——滇西南、滇东南河谷的多元耕织文明",
                        spatial: "温暖明亮的色调，模拟河谷湿热氛围",
                        intro: "",
                        exhibits: [
                            { id: "2-4-S-01", name: "滇西南低热河谷热带田园景观", type: "模型/图片", ref: "参考西双版纳实景照片建模", note: "热带特色农耕风貌", evidence: "依据汇报稿及《农耕文化》（西双版纳卷）", desc: "" },
                            { id: "2-4-P-01", name: "景洪傣族犁", type: "模型/图片", ref: "参考《云南不同地区畜力犁比较分析》附图", note: "热区旱地犁具", evidence: "同上", desc: "" },
                            { id: "2-4-P-02", name: "西双版纳傣族大框架直辕犁", type: "模型/图片", ref: "同上", note: "竹制直辕为特色", evidence: "同上", desc: "竹制直辕是云南就地取材的本土化创新" },
                            { id: "2-4-P-03", name: "热带特色经济作物系列", type: "模型/图片（系列）", ref: "参考《滇南本草》及云南特色物产资料", note: "热区特色物产", evidence: "依据汇报稿", desc: "茶叶、甘蔗、咖啡、热带水果——普洱茶、甘蔗等特色作物在云南热区形成与中原完全不同的农耕物产体系" },
                            { id: "2-4-P-04", name: "热带野生稻标本", type: "模型/图片", ref: "参考云南野生稻资源调查资料", note: "亚洲栽培稻起源证据", evidence: "傣族先民最早进行野生稻人工驯化", desc: "" },
                            { id: "2-4-P-05", name: "普洱景迈山古茶林文化景观——林下茶种植模型", type: "模型/图片", ref: "参考景迈山古茶林实景照片建模", note: "\"林下茶种植\"模式", evidence: "景迈山2023年列入《世界遗产名录》", desc: "\"林下茶种植\"是云南先民对中原茶文化（源于巴蜀）的本土化创新" },
                            { id: "2-4-P-06", name: "布朗族\"茶祖\"帕哎冷传说场景", type: "图片/文字", ref: "参考景迈山布朗族口述史制作", note: "茶文化农耕信仰", evidence: "布朗族先人帕哎冷遗训", desc: "\"只给你们留下茶树，让子孙后代取用不尽\"——茶在云南农耕文化中具有独特的精神地位" },
                            { id: "2-4-P-07", name: "普洱茶传统制作技艺模型系列", type: "模型/图片（系列）", ref: "参考国家级非遗项目资料制作", note: "普洱茶加工技艺展示", evidence: "2008年列入第二批国家级非物质文化遗产名录", desc: "国家级非物质文化遗产·传统技艺。普洱茶传统制作技艺起源于清雍正十年（1732年），历经杀青、揉捻、晒青、蒸压等工序。2022年作为\"中国传统制茶技艺及其相关习俗\"一部分入选人类非物质文化遗产代表作名录。" },
                            { id: "2-4-D-01", name: "云南普洱古茶园与茶文化系统——全球重要农业文化遗产展板", type: "文字/图片", ref: "参考联合国粮农组织资料", note: "2012年全球重要农业文化遗产", evidence: "联合国粮农组织", desc: "" },
                            { id: "2-4-Q-01", name: "布朗族古训", type: "文字", ref: "---", note: "嵌入景迈山古茶林展项旁", evidence: "布朗族先人帕哎冷遗训", desc: "\"只给你们留下茶树，让子孙后代取用不尽。\"" }
                        ]
