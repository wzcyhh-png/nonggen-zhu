                '5-1-P-03': 'gallery-5-1-P-03',
                '5-1-P-04': 'gallery-5-1-P-04',
                // 第五展区 - 科研成果（第二单元：守正创新）
                '5-2-P-01': 'gallery-5-2-P-01',
                '5-2-P-02': 'gallery-5-2-P-02',
                '5-2-P-03': 'gallery-5-2-P-03',
                // 第五展区 - 教学实习农场（第三单元：耕读育人）
                '5-3-P-01': 'gallery-5-3-P-01',
                '5-3-S-01': 'gallery-5-3-S-01',
                '5-3-P-02': 'gallery-5-3-P-02',
                // 第五展区 - 科技推广（第四单元：泽被乡野）
                '5-4-V-01': 'gallery-5-4-V-01',
                '5-4-P-01': 'gallery-5-4-P-01',
                '5-4-P-02': 'gallery-5-4-P-02',
                // 第六展区 - 农业文化遗产（第一单元：古法新承）
                '6-1-P-01': 'gallery-6-1-P-01',
                '6-1-P-02': 'gallery-6-1-P-02',
                '6-1-P-03': 'gallery-6-1-P-03',
                // 第六展区 - 种业（第二单元：种源赓续）
                '6-2-P-01': 'gallery-6-2-P-01',
                '6-2-P-02': 'gallery-6-2-P-02',
                // 第六展区 - 高原特色农业（第三单元）
                '6-3-P-01': 'gallery-6-3-P-01',
                // 第六展区 - 数字农业（第三单元：品牌化发展中的数字化应用）
                '6-3-P-02': 'gallery-6-3-P-02',
                // 第六展区 - 国际培训（第四单元：开放互鉴）
                '6-4-P-01': 'gallery-6-4-P-01',
                '6-4-P-02': 'gallery-6-4-P-02',
                // 第七展区 - 绿色发展（第一单元：生态价值）
                '7-1-P-01': 'gallery-7-1-P-01',
                '7-1-P-02': 'gallery-7-1-P-02',
                '7-1-P-03': 'gallery-7-1-P-03',
                '7-1-P-04': 'gallery-7-1-P-04',
                // 第七展区 - 数字农业应用（第二单元）
                '7-2-P-01': 'gallery-7-2-P-01',
                '7-2-P-02': 'gallery-7-2-P-02',
                '7-2-P-03': 'gallery-7-2-P-03',
                // 第七展区 - 高原特色农业（第三单元）
                '7-3-P-01': 'gallery-7-3-P-01',
                '7-3-P-02': 'gallery-7-3-P-02',
                // 第七展区 - 新农人（第四单元：薪火相传）
                '7-4-P-01': 'gallery-7-4-P-01',
                '7-4-P-02': 'gallery-7-4-P-02',
                '7-4-V-01': 'gallery-7-4-V-01',
            };

            const galleryId = galleryMap[exhibit.id];
            if (galleryId) {
                const galleryImages = getGalleryImages(galleryId);
                return `
                    <div class="exhibit-card has-gallery">
                        <div class="exhibit-image">
                            <span class="image-tag">${exhibit.type}</span>
                            ${renderImageGallery(galleryId, galleryImages)}
                        </div>
                        <div class="exhibit-content">
                            <div class="exhibit-header">
                                <span class="exhibit-id">${exhibit.id}</span>
                            </div>
                            <div class="exhibit-name">${exhibit.name}</div>
                            ${exhibit.desc ? `<div class="exhibit-detail"><span class="exhibit-detail-label">说明：</span>${exhibit.desc}</div>` : ''}
                            ${exhibit.evidence ? `<div class="exhibit-detail"><span class="exhibit-detail-label">佐证：</span>${exhibit.evidence}</div>` : ''}
                            ${exhibit.ref ? `<div class="exhibit-detail"><span class="exhibit-detail-label">参考：</span>${exhibit.ref}</div>` : ''}
                            ${exhibit.note ? `<div class="exhibit-note">${exhibit.note}</div>` : ''}
                        </div>
                    </div>
                `;
            }

            // 根据类型确定图标
            let icon = '🖼️';
            if (exhibit.type.includes('视频')) icon = '🎬';
            else if (exhibit.type.includes('音频')) icon = '🎵';
            else if (exhibit.type.includes('模型')) icon = '🏺';
            else if (exhibit.type.includes('地图')) icon = '🗺️';
            else if (exhibit.type.includes('文字')) icon = '📜';
            else if (exhibit.type.includes('互动')) icon = '💫';
            else if (exhibit.type.includes('动画')) icon = '🎞️';

            return `
                <div class="exhibit-card">
                    <div class="exhibit-image">
                        <span class="image-tag">${exhibit.type}</span>
                        <div class="placeholder">
                            <div class="placeholder-icon">${icon}</div>
                            <div class="placeholder-text">图片占位</div>
                        </div>
                    </div>
                    <div class="exhibit-content">
                        <div class="exhibit-header">
                            <span class="exhibit-id">${exhibit.id}</span>
                        </div>
                        <div class="exhibit-name">${exhibit.name}</div>
                        ${exhibit.desc ? `<div class="exhibit-detail"><span class="exhibit-detail-label">说明：</span>${exhibit.desc}</div>` : ''}
                        ${exhibit.evidence ? `<div class="exhibit-detail"><span class="exhibit-detail-label">佐证：</span>${exhibit.evidence}</div>` : ''}
                        ${exhibit.ref ? `<div class="exhibit-detail"><span class="exhibit-detail-label">参考：</span>${exhibit.ref}</div>` : ''}
                        ${exhibit.note ? `<div class="exhibit-note">${exhibit.note}</div>` : ''}
                    </div>
                </div>
            `;
        }

        // ==================== 渲染遗址分布地图SVG（博物馆风格） ====================
        function renderSiteMapSVG() {
            return `
                <div style="position:relative;width:100%;background:#F8F5F0;border:1px solid #D4C4A8;border-radius:4px;overflow:hidden;">
