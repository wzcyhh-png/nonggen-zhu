        // ==================== 滇池沿岸坝区水田景观图片 ====================
        const dianchiPaddyImages = [
            { src: "images/dianchi_paddy/dianchi_paddy_field_01.webp", caption: "【实景照片】昆明周边灌溉稻田——石林附近稻田，不同成熟期的稻谷呈现从绿到黄的色彩变化。灌溉系统使云南坝区实现一年多熟，是滇中核心稻作产区的典型景观（来源：Wikimedia Commons, CC BY-SA 3.0）", title: "昆明周边灌溉稻田" },
            { src: "images/dianchi_paddy/dianchi_paddy_field_02.webp", caption: "【历史照片】中国水稻插秧（1911年）——美国农学家F.H. King《四十世纪的农民》一书中的历史照片，记录了清末中国农民插秧劳作场景，展现了传统水稻移栽技术的精湛与高效（来源：Wikimedia Commons, 公共领域）", title: "中国传统水稻插秧" },
            { src: "images/dianchi_paddy/dianchi_paddy_field_03.webp", caption: "【实景照片】从西山俯瞰滇池——昆明西山眺望滇池湖面与周边坝区，可见滇池水域与环湖平原全貌。滇池是云南最大的淡水湖，环湖坝区自古为滇中农业核心地带（来源：Wikimedia Commons, CC BY-SA 3.0）", title: "西山俯瞰滇池" },
            { src: "images/dianchi_paddy/dianchi_paddy_field_04.webp", caption: "【历史照片】中国农民水田牛耕（约1918-1938年）——民国时期传教士拍摄的彩色幻灯片，记录了中国农民驱使水牛耕犁水田的传统场景。二牛牵引木犁翻耕，是延续两千余年的耕作方式（来源：Wikimedia Commons, 公共领域）", title: "中国传统水田牛耕" },
            { src: "images/dianchi_paddy/dianchi_paddy_field_05.webp", caption: "【实景照片】滇池湖畔全景——2026年航拍滇池全景，展现滇池水域与环湖坝区全貌。滇池流域是云南农业文明的重要发源地，环湖坝区至今仍是滇中核心粮产区（来源：Wikimedia Commons, CC BY-SA 4.0）", title: "滇池湖畔全景" },
        ];

