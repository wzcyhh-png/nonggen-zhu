        function downloadGalleryImage(galleryId) {
            const gallery = document.getElementById(galleryId);
            if (!gallery) return;
            const images = getGalleryImages(galleryId);
            const current = parseInt(gallery.dataset.current || 0);
            const img = images[current];
            if (img) {
                downloadImage(img.src, img.title || img.caption);
            }
        }

        function setGalleryImage(galleryId, index) {
            const gallery = document.getElementById(galleryId);
            if (!gallery) return;
            const images = getGalleryImages(galleryId);
            if (index < 0 || index >= images.length) return;

            gallery.dataset.current = index;
            const img = images[index];

            const mainImg = gallery.querySelector('.gallery-main-img');
            mainImg.src = img.src;
            mainImg.alt = img.title;

            const caption = gallery.querySelector('.gallery-main-caption');
            caption.textContent = img.caption;

            const counter = gallery.querySelector('.gallery-counter');
            counter.textContent = `${index + 1} / ${images.length}`;

            const thumbs = gallery.querySelectorAll('.gallery-thumb');
            thumbs.forEach((thumb, i) => {
                thumb.classList.toggle('active', i === index);
            });
        }

        function nextGalleryImage(galleryId) {
            const gallery = document.getElementById(galleryId);
            if (!gallery) return;
            const total = parseInt(gallery.dataset.total);
            const current = parseInt(gallery.dataset.current);
            const next = (current + 1) % total;
            setGalleryImage(galleryId, next);
        }

        function prevGalleryImage(galleryId) {
            const gallery = document.getElementById(galleryId);
            if (!gallery) return;
            const total = parseInt(gallery.dataset.total);
            const current = parseInt(gallery.dataset.current);
            const prev = (current - 1 + total) % total;
            setGalleryImage(galleryId, prev);
        }

        // ==================== 图片放大弹窗（Lightbox） ====================
        let currentLightboxGallery = null;
        let currentLightboxIndex = 0;

        function openLightbox(galleryId, startIndex = null) {
            const images = getGalleryImages(galleryId);
            if (images.length === 0) return;

            currentLightboxGallery = galleryId;
            const gallery = document.getElementById(galleryId);
            currentLightboxIndex = startIndex !== null ? startIndex : parseInt(gallery.dataset.current);

            let lightbox = document.getElementById('image-lightbox');
            if (!lightbox) {
                lightbox = document.createElement('div');
                lightbox.id = 'image-lightbox';
                lightbox.className = 'image-lightbox';
                lightbox.onclick = function(e) {
                    if (e.target.id === 'image-lightbox') closeLightbox();
                };
                document.body.appendChild(lightbox);
            }

            updateLightboxContent();
            lightbox.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function updateLightboxContent() {
            const images = getGalleryImages(currentLightboxGallery);
            const img = images[currentLightboxIndex];
            const lightbox = document.getElementById('image-lightbox');

            lightbox.innerHTML = `
                <button class="lightbox-close" onclick="closeLightbox()">×</button>
                <button class="lightbox-download" onclick="event.stopPropagation(); downloadCurrentImage()">下载原图</button>
                <button class="lightbox-nav lightbox-prev" onclick="event.stopPropagation(); lightboxPrev()">‹</button>
                <button class="lightbox-nav lightbox-next" onclick="event.stopPropagation(); lightboxNext()">›</button>
                <div class="lightbox-img-container">
                    <img src="${img.src}" alt="${img.title}" loading="lazy">
                    <div class="lightbox-caption">${img.caption}</div>
                    <div class="lightbox-counter">${currentLightboxIndex + 1} / ${images.length} · ${img.title}</div>
                </div>
            `;
        }

        function downloadCurrentImage() {
            const images = getGalleryImages(currentLightboxGallery);
            const img = images[currentLightboxIndex];
            downloadImage(img.src, img.title || img.caption);
        }

        function downloadImage(src, title) {
            // 下载原图：如果当前是WebP格式，自动还原为原始JPG/PNG格式
            let downloadSrc = src;
            let downloadExt = src.split('.').pop() || 'jpg';
            if (downloadExt === 'webp') {
                // 将.webp替换为.jpg（绝大多数原始图片是JPG）
                downloadSrc = src.replace(/\.webp$/, '.jpg');
                downloadExt = 'jpg';
            }
            const link = document.createElement('a');
            link.href = downloadSrc;
            const safeTitle = (title || '图片').replace(/[\\/:*?"<>|]/g, '_');
            link.download = `${safeTitle}.${downloadExt}`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // 单图lightbox（用于非gallery图片）
        let singleImageMode = false;
        function openSingleImageLightbox(src, title, caption) {
            singleImageMode = true;
            let lightbox = document.getElementById('image-lightbox');
            if (!lightbox) {
                lightbox = document.createElement('div');
                lightbox.id = 'image-lightbox';
                lightbox.className = 'image-lightbox';
                lightbox.onclick = function(e) {
                    if (e.target.id === 'image-lightbox') closeLightbox();
                };
                document.body.appendChild(lightbox);
            }

            const displayTitle = title || caption || '图片';
            const displayCaption = caption || title || '';

            lightbox.innerHTML = `
                <button class="lightbox-close" onclick="closeLightbox()">×</button>
                <button class="lightbox-download" onclick="event.stopPropagation(); downloadImage('${src}', '${displayTitle.replace(/'/g, "\\'")}')">下载原图</button>
                <div class="lightbox-img-container">
                    <img src="${src}" alt="${displayTitle}">
                    <div class="lightbox-caption">${displayCaption}</div>
                    <div class="lightbox-counter">${displayTitle}</div>
                </div>
            `;

            lightbox.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            const lightbox = document.getElementById('image-lightbox');
            if (lightbox) {
                lightbox.classList.remove('show');
                setTimeout(() => {
                    if (lightbox.parentNode) {
                        lightbox.parentNode.removeChild(lightbox);
                    }
                }, 300);
            }
            document.body.style.overflow = '';
            currentLightboxGallery = null;
            singleImageMode = false;
        }

        function lightboxNext() {
            if (singleImageMode) return;
            const images = getGalleryImages(currentLightboxGallery);
            currentLightboxIndex = (currentLightboxIndex + 1) % images.length;
            updateLightboxContent();
        }

        function lightboxPrev() {
            if (singleImageMode) return;
            const images = getGalleryImages(currentLightboxGallery);
            currentLightboxIndex = (currentLightboxIndex - 1 + images.length) % images.length;
            updateLightboxContent();
        }

        // 键盘控制lightbox和画轴查看器
        document.addEventListener('keydown', function(e) {
            // 画轴式文献查看器（优先级最高）
            const scrollLb = document.getElementById('scroll-lightbox');
            if (scrollLb && scrollLb.classList.contains('show')) {
                if (e.key === 'Escape') closeScrollLightbox();
                else if (e.key === 'ArrowRight') scrollLightboxNext();
                else if (e.key === 'ArrowLeft') scrollLightboxPrev();
                return;
            }

            // 地图弹窗
            const mapLightbox = document.getElementById('map-lightbox');
            if (mapLightbox && mapLightbox.classList.contains('show')) {
                if (e.key === 'Escape') closeMapLightbox();
                return;
            }

            // 图片lightbox
            const lightbox = document.getElementById('image-lightbox');
            if (!lightbox || !lightbox.classList.contains('show')) return;

            if (e.key === 'Escape') closeLightbox();
            else if (e.key === 'ArrowRight') lightboxNext();
            else if (e.key === 'ArrowLeft') lightboxPrev();
        });

        // ==================== 画轴式文献查看器 ====================
        let currentScrollGallery = null;
        let currentScrollIndex = 0;

        function openScrollLightbox(galleryId, startIndex = 0) {
            const images = getGalleryImages(galleryId);
            if (images.length === 0) return;

            currentScrollGallery = galleryId;
            currentScrollIndex = startIndex;

            let slb = document.getElementById('scroll-lightbox');
            if (!slb) {
                slb = document.createElement('div');
                slb.id = 'scroll-lightbox';
                slb.className = 'scroll-lightbox';
                slb.onclick = function(e) {
                    if (e.target.id === 'scroll-lightbox') closeScrollLightbox();
                };
                document.body.appendChild(slb);
            }

            updateScrollLightboxContent();
            // 延迟一帧后添加show类，确保transition生效
            requestAnimationFrame(() => {
                slb.classList.add('show');
            });
            document.body.style.overflow = 'hidden';
        }

        function updateScrollLightboxContent() {
            const images = getGalleryImages(currentScrollGallery);
            if (images.length === 0) return;
            const img = images[currentScrollIndex];
            const slb = document.getElementById('scroll-lightbox');
            if (!slb) return;

            slb.innerHTML = `
                <button class="scroll-lightbox-close" onclick="event.stopPropagation(); closeScrollLightbox()">×</button>
                <button class="scroll-lightbox-download" onclick="event.stopPropagation(); downloadScrollImage()">下载原图</button>
                ${images.length > 1 ? `
                <button class="scroll-lightbox-nav scroll-lightbox-prev" onclick="event.stopPropagation(); scrollLightboxPrev()">‹</button>
                <button class="scroll-lightbox-nav scroll-lightbox-next" onclick="event.stopPropagation(); scrollLightboxNext()">›</button>
                ` : ''}
                <div class="scroll-painting-wrap" onclick="event.stopPropagation();">
                    <div class="scroll-rod-top"></div>
                    <div class="scroll-painting-body" id="scroll-painting-body">
                        <img src="${img.src}" alt="${img.title}" style="display:block;">
                    </div>
                    <div class="scroll-rod-bottom"></div>
                    <div class="scroll-painting-info">${img.caption || img.title}</div>
                    <div class="scroll-painting-counter">${currentScrollIndex + 1} / ${images.length}</div>
                </div>
            `;

            // 图片加载后滚动到顶部
            const body = document.getElementById('scroll-painting-body');
            if (body) body.scrollTop = 0;
        }

        function downloadScrollImage() {
            const images = getGalleryImages(currentScrollGallery);
            if (images.length === 0) return;
            const img = images[currentScrollIndex];
            downloadImage(img.src, img.title || img.caption);
        }

        function closeScrollLightbox() {
            const slb = document.getElementById('scroll-lightbox');
            if (slb) {
                slb.classList.remove('show');
                setTimeout(() => {
                    if (slb.parentNode) slb.parentNode.removeChild(slb);
                }, 400);
            }
            document.body.style.overflow = '';
            currentScrollGallery = null;
            currentScrollIndex = 0;
        }

        function scrollLightboxNext() {
            const images = getGalleryImages(currentScrollGallery);
            if (images.length === 0) return;
            currentScrollIndex = (currentScrollIndex + 1) % images.length;
            updateScrollLightboxContent();
        }

        function scrollLightboxPrev() {
            const images = getGalleryImages(currentScrollGallery);
            if (images.length === 0) return;
            currentScrollIndex = (currentScrollIndex - 1 + images.length) % images.length;
            updateScrollLightboxContent();
        }

        // ==================== 交互功能 ====================
        function toggleSection(sectionId) {
            const section = document.getElementById('nav-' + sectionId);
            section.classList.toggle('collapsed');
        }

        function scrollToSection(sectionId) {
            const element = document.getElementById(sectionId);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            // 移动端关闭侧边栏
            if (window.innerWidth <= 900) {
                document.getElementById('sidebar').classList.remove('open');
            }
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ==================== 滚动监听 ====================
        function handleScroll() {
            // 返回顶部按钮
            const backToTop = document.getElementById('backToTop');
            if (window.scrollY > 500) {
                backToTop.classList.add('visible');
            } else {
                backToTop.classList.remove('visible');
            }

            // 导航高亮
            const navUnits = document.querySelectorAll('.nav-unit');
            let currentUnit = null;

            exhibitionData.forEach((section) => {
                section.units.forEach((unit) => {
                    const element = document.getElementById(unit.id);
                    if (element) {
                        const rect = element.getBoundingClientRect();
                        if (rect.top <= 150) {
                            currentUnit = unit.id;
                        }
                    }
                });
                // 序厅/尾厅特殊处理
                if (section.type === 'hall') {
                    const element = document.getElementById(section.id);
                    if (element) {
                        const rect = element.getBoundingClientRect();
                        if (rect.top <= 150) {
                            currentUnit = section.id;
                        }
                    }
                }
            });

            navUnits.forEach((unit) => {
                unit.classList.remove('active');
            });

            if (currentUnit) {
                // 找到对应的导航项并高亮
                const navItems = document.querySelectorAll('.nav-unit');
                // 简化处理：根据滚动位置大致判断
            }
        }

        // ==================== 初始化 ====================
        document.addEventListener('DOMContentLoaded', function() {
            renderNav();
            renderContent();
            window.addEventListener('scroll', handleScroll);
        });
    </script>

<!-- 图片懒加载优化 -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // 使用 IntersectionObserver 实现图片懒加载
    if ('IntersectionObserver' in window) {
        const lazyImages = document.querySelectorAll('img[data-src]');
        const imageObserver = new IntersectionObserver(function(entries, observer) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    img.src = img.dataset.src;
                    img.removeAttribute('data-src');
                    observer.unobserve(img);
                }
            });
        }, {
            rootMargin: '200px 0px', // 提前200px开始加载
            threshold: 0.01
        });
        
        lazyImages.forEach(function(img) {
            imageObserver.observe(img);
        });
    } else {
        // 降级：直接加载所有图片
        document.querySelectorAll('img[data-src]').forEach(function(img) {
            img.src = img.dataset.src;
        });
    }
});
</script>
<!-- copilot-lazy-script -->
<script defer>
(function(){
  function setLazy(){
    document.querySelectorAll('img').forEach(function(img){
      if(!img.hasAttribute('loading')) img.setAttribute('loading','lazy');
      if(!img.hasAttribute('decoding')) img.setAttribute('decoding','async');
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', setLazy); else setLazy();
})();
</script>
</body>
</html>

